{
  "swap-approved": {
    "assertions": [
      {
        "id": "price-switched",
        "label": "Phone plan is now Essentials",
        "type": "record-field",
        "resource": "subscriptions",
        "recordId": "sub_lana_phone",
        "path": [
          "items",
          "data",
          "0",
          "price",
          "id"
        ],
        "op": "equals",
        "value": "price_phone_essentials"
      },
      {
        "id": "still-active",
        "label": "Phone plan still active",
        "type": "record-field",
        "resource": "subscriptions",
        "recordId": "sub_lana_phone",
        "path": [
          "status"
        ],
        "op": "equals",
        "value": "active"
      },
      {
        "id": "ticket-solved",
        "label": "Ticket 1 solved",
        "type": "record-field",
        "resource": "tickets",
        "recordId": "1",
        "path": [
          "status"
        ],
        "op": "equals",
        "value": "solved"
      },
      {
        "id": "ticket-tagged",
        "label": "Ticket 1 tagged swap_applied",
        "type": "record-field",
        "resource": "tickets",
        "recordId": "1",
        "path": [
          "tags"
        ],
        "op": "includes",
        "value": "swap_applied"
      },
      {
        "id": "scope",
        "label": "Only the phone plan and ticket 1 change",
        "type": "change-scope",
        "allowed": [
          {
            "resource": "subscriptions",
            "kinds": [
              "updated"
            ],
            "recordIds": [
              "sub_lana_phone"
            ]
          },
          {
            "resource": "tickets",
            "kinds": [
              "updated"
            ],
            "recordIds": [
              "1"
            ]
          }
        ]
      },
      {
        "id": "stream-untouched",
        "label": "StreamBox subscription unchanged",
        "type": "unchanged",
        "resource": "subscriptions",
        "recordId": "sub_lana_stream"
      },
      {
        "id": "roommate-untouched",
        "label": "Roommate's phone line unchanged",
        "type": "unchanged",
        "resource": "subscriptions",
        "recordId": "sub_roommate_phone"
      },
      {
        "id": "no-refunds",
        "label": "No refunds attempted",
        "type": "forbidden-request",
        "method": "POST",
        "path": "/v1/refunds"
      },
      {
        "id": "no-cancel",
        "label": "No cancellation attempted",
        "type": "forbidden-request",
        "method": "DELETE",
        "path": "/v1/subscriptions/sub_lana_phone"
      },
      {
        "id": "no-proration",
        "label": "No proration line items",
        "type": "changed-count",
        "resource": "invoiceitems",
        "kind": "created",
        "count": 0
      },
      {
        "id": "one-reply",
        "label": "Exactly one reply on ticket 1",
        "type": "record-field",
        "resource": "tickets",
        "recordId": "1",
        "path": [
          "comments"
        ],
        "op": "count",
        "value": 2
      }
    ]
  },

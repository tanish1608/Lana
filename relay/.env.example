# Dial (messaging). Without a key the relay still runs; sends are recorded as failed.
DIAL_API_KEY=
DIAL_NUMBER=+13144649040
# Only needed if Dial delivers by webhook instead of the event stream.
DIAL_WEBHOOK_SECRET=

# Phone numbers that may talk to FWM, and the user each one belongs to.
PAIRED_PHONES=+14085550101=user_ashwin
# Six digits the app enters once to pair. Random on each boot if unset.
PAIRING_CODE=
PORT=8787
# Base URL the phone uses for attachment links (a tunnel URL when the phone is not on this machine).
PUBLIC_BASE_URL=http://localhost:8787
# 1 enables POST /dev/inbound (local testing and demo fallback).
RELAY_DEV=0

# Keewano: ingest key (project settings) for seeding, PAT for the MCP query.
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=72ce4c09-50a8-4746-8baf-f5b0c40d2fd4

# Demo phone: a second Dial number that plays the user (Dial-to-Dial SMS works without 10DLC)
SIM_PHONE=
SIM_PHONE_ID=
